{
  "$defs": {
    "ClusterAssessment": {
      "additionalProperties": false,
      "description": "The four SWOT quadrants for one canvas cluster.",
      "properties": {
        "cluster": {
          "$ref": "#/$defs/SWOTCluster"
        },
        "opportunities": {
          "items": {
            "$ref": "#/$defs/SWOTStatement"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Opportunities",
          "type": "array"
        },
        "strengths": {
          "items": {
            "$ref": "#/$defs/SWOTStatement"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Strengths",
          "type": "array"
        },
        "threats": {
          "items": {
            "$ref": "#/$defs/SWOTStatement"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Threats",
          "type": "array"
        },
        "weaknesses": {
          "items": {
            "$ref": "#/$defs/SWOTStatement"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Weaknesses",
          "type": "array"
        }
      },
      "required": [
        "cluster",
        "strengths",
        "weaknesses",
        "opportunities",
        "threats"
      ],
      "title": "ClusterAssessment",
      "type": "object"
    },
    "SWOTCluster": {
      "description": "The four canvas clusters a SWOT assessment is grouped by.\n\nBMG, Strategy -> Evaluating Business Models (pp. 217-223): the book\ndoes not assess the nine blocks one by one but in these four groups.\nSee `SWOT_CLUSTER_SECTIONS` for which blocks each one covers.",
      "enum": [
        "value_proposition",
        "cost_revenue",
        "infrastructure",
        "customer_interface"
      ],
      "title": "SWOTCluster",
      "type": "string"
    },
    "SWOTStatement": {
      "additionalProperties": false,
      "description": "One statement in a SWOT quadrant, tied to this canvas's actual content.",
      "properties": {
        "certainty": {
          "description": "Certainty of the evaluation, 1-10.",
          "maximum": 10,
          "minimum": 1,
          "title": "Certainty",
          "type": "integer"
        },
        "importance": {
          "description": "Importance to the business model, 1-10.",
          "maximum": 10,
          "minimum": 1,
          "title": "Importance",
          "type": "integer"
        },
        "text": {
          "maxLength": 400,
          "minLength": 10,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "importance",
        "certainty"
      ],
      "title": "SWOTStatement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Output of the `assessment` stage: one entry per cluster, in `SWOTCluster` order.",
  "properties": {
    "clusters": {
      "items": {
        "$ref": "#/$defs/ClusterAssessment"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Clusters",
      "type": "array"
    }
  },
  "required": [
    "clusters"
  ],
  "title": "Assessment",
  "type": "object"
}
