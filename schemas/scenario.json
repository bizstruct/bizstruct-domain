{
  "$defs": {
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "title": "MetricValue",
      "type": "object"
    },
    "Persona": {
      "additionalProperties": false,
      "description": "The protagonist of the scenario — should be the same persona as the\nproject's `empathy_map`, not a newly invented one.",
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "pain_point": {
          "maxLength": 300,
          "minLength": 10,
          "title": "Pain Point",
          "type": "string"
        },
        "role": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "name",
        "role",
        "pain_point"
      ],
      "title": "Persona",
      "type": "object"
    },
    "ScenarioMetrics": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/MetricValue"
        },
        "before": {
          "$ref": "#/$defs/MetricValue"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "title": "ScenarioMetrics",
      "type": "object"
    },
    "TimelineStep": {
      "additionalProperties": false,
      "description": "One step of the persona's journey.",
      "properties": {
        "step_type": {
          "enum": [
            "context",
            "goal",
            "action",
            "result",
            "impact"
          ],
          "title": "Step Type",
          "type": "string"
        },
        "text": {
          "maxLength": 300,
          "minLength": 10,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "step_type",
        "text"
      ],
      "title": "TimelineStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Output of the `scenario` stage: a before/after user journey.",
  "properties": {
    "metrics": {
      "$ref": "#/$defs/ScenarioMetrics"
    },
    "persona": {
      "$ref": "#/$defs/Persona"
    },
    "timeline": {
      "items": {
        "$ref": "#/$defs/TimelineStep"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Timeline",
      "type": "array"
    }
  },
  "required": [
    "persona",
    "timeline",
    "metrics"
  ],
  "title": "Scenario",
  "type": "object"
}
