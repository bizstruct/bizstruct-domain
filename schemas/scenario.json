{
  "$defs": {
    "AdaptationQuestion": {
      "additionalProperties": false,
      "description": "How one canvas area would have to adapt in this future.",
      "properties": {
        "area": {
          "$ref": "#/$defs/ScenarioAdaptationArea"
        },
        "question": {
          "maxLength": 300,
          "minLength": 10,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "area",
        "question"
      ],
      "title": "AdaptationQuestion",
      "type": "object"
    },
    "FutureScenarioCase": {
      "additionalProperties": false,
      "description": "One possible future, from one combination of driver values.",
      "properties": {
        "adaptation_questions": {
          "description": "One question per significant canvas area, each area at most once.",
          "items": {
            "$ref": "#/$defs/AdaptationQuestion"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Adaptation Questions",
          "type": "array"
        },
        "narrative": {
          "maxLength": 1200,
          "minLength": 40,
          "title": "Narrative",
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "narrative",
        "adaptation_questions"
      ],
      "title": "FutureScenarioCase",
      "type": "object"
    },
    "ScenarioAdaptationArea": {
      "description": "Canvas areas a future scenario asks adaptation questions about.\n\nBMG, Design -> Scenarios, type 2 (pp. 187-188): value proposition, key\nresources/activities, revenue, costs, partnerships, customer\nrelationships.",
      "enum": [
        "value_proposition",
        "key_resources_activities",
        "revenue_streams",
        "cost_structure",
        "key_partners",
        "customer_relationships"
      ],
      "title": "ScenarioAdaptationArea",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Output of the `scenario` stage.",
  "properties": {
    "scenario_matrix": {
      "items": {
        "$ref": "#/$defs/FutureScenarioCase"
      },
      "maxItems": 4,
      "minItems": 2,
      "title": "Scenario Matrix",
      "type": "array"
    },
    "uncertainty_drivers": {
      "items": {
        "maxLength": 300,
        "minLength": 10,
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 2,
      "title": "Uncertainty Drivers",
      "type": "array"
    }
  },
  "required": [
    "uncertainty_drivers",
    "scenario_matrix"
  ],
  "title": "FutureScenario",
  "type": "object"
}
